---
import Icon from '../components/Icon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import PortalPreview from '../components/PortalPreview.astro';
---
<SiteLayout title="The Apex Experience" description="A renovation process you can follow. Discover Apex’s private client portal for work plans, project photos, schedules, documents, and shared property access in North Alabama.">
  <PageHero eyebrow="The Apex experience" title="A better view of the whole picture." description="The transformation matters. So does how it feels to get there. Apex brings the details out of scattered conversations and into a more connected project experience."><a href="/start-your-project/" class="button button-dark">Plan your next chapter <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></PageHero>
  <section class="section section-stone"><div class="wrap experience-demo"><div class="section-heading" data-reveal><span class="eyebrow">Your private project workspace</span><h2>Less chasing.<br />More clarity.</h2><p>Explore this illustrative preview of the kind of project information your client portal brings together.</p></div><PortalPreview /></div></section>
  <section class="section"><div class="wrap"><div class="section-heading" data-reveal><span class="eyebrow">One property. One connected record.</span><h2>The details deserve a home, too.</h2></div><div class="feature-grid">
    <article class="feature-card" data-reveal><span class="number">01</span><h3>A visible work plan</h3><p>See the recorded scope and checklist, understand the stages, and follow completion as the work is updated.</p></article>
    <article class="feature-card" data-reveal><span class="number">02</span><h3>Photos with context</h3><p>A site journal keeps images and notes attached to your property, giving individual updates a place in the bigger story.</p></article>
    <article class="feature-card" data-reveal><span class="number">03</span><h3>Who’s expected on site</h3><p>Trade coordination separates planned visits from recorded on-site status, so a scheduled date is not confused with a confirmed arrival.</p></article>
    <article class="feature-card" data-reveal><span class="number">04</span><h3>Documents in one place</h3><p>Project documents, selections, and recorded payment information sit within the project rather than across separate message threads.</p></article>
    <article class="feature-card" data-reveal><span class="number">05</span><h3>Access that fits your property</h3><p>Partners can have their own accounts and access to shared projects. Other properties remain separate.</p></article>
    <article class="feature-card" data-reveal><span class="number">06</span><h3>A lasting project record</h3><p>The property’s scope, journal, and progress stay organized as its story develops, from pre-construction through the work.</p></article>
  </div></div></section>
  <section class="section section-dark"><div class="wrap split-content"><div data-reveal><span class="eyebrow">Already an Apex client?</span><h2>Your project<br />is right here.</h2></div><div class="prose" data-reveal><p>Sign in with the account provided for your project. The client portal opens separately from this website and only shows the properties your account can access.</p><a href="https://apexpropertyportal.com/" target="_blank" rel="noopener noreferrer" class="button button-gold">Open the client portal <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><p class="muted">Portal information reflects recorded updates. It is not live site surveillance or an automatic guarantee of schedule or completion.</p></div></div></section>
  <CTA title="A better process starts with a conversation." />
</SiteLayout>
