---
import ServicePage from "../components/ServicePage.astro";
const page = {
  "title": "The Apex Process | Property Rehab from Scope to Handover",
  "description": "A defined rehab process for North Alabama properties: condition review, agreed scope, coordinated work, client portal visibility, inspections and handover.",
  "kicker": "THE APEX PROCESS",
  "line1": "COMPLETE REHAB.",
  "line2": "CLEAR PROCESS.",
  "intro": "A property transformation needs a defined path. Apex coordinates the scope, sequence and project record—from the first condition review to the agreed work at handover.",
  "items": [
    [
      "PROPERTY & OBJECTIVE",
      "Review the location, property type, existing condition and intended use. Establish whether the project is being prepared for rental, resale or owner occupancy."
    ],
    [
      "SITE REVIEW & SCOPE",
      "Discuss repairs, layouts, finishes, dependencies and the professionals required. Identify relevant permitting and inspection steps."
    ],
    [
      "AGREEMENT & PLAN",
      "Confirm the project-specific scope, pricing, responsibilities and schedule. Establish the selections and decisions needed to proceed."
    ],
    [
      "COORDINATED WORK",
      "Bring the project team and trades into sequence. Address site conditions, decisions and scope changes through the agreed process."
    ],
    [
      "CLIENT VISIBILITY",
      "Follow the recorded scope, work plan, photographs, payment records and documents in your private client portal throughout the project."
    ],
    [
      "INSPECTIONS & HANDOVER",
      "Coordinate required inspections, address agreed corrections and review the punch list. Organize the closeout record as the property moves toward its next use."
    ]
  ]
};
---
<ServicePage {...page} />
