---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="Project Brief | North Alabama Property Rehab" description="Submit a residential, multifamily or commercial rehab brief. Share the property, investment objective and scope with Apex in North Alabama." dark>
<section class="v2-brief-header wrap"><span class="eyebrow">YOUR PROPERTY / THE NEXT MOVE</span><h1>DEFINE THE<br /><span>NEXT CHAPTER.</span></h1></section>
<section class="wrap v2-brief-layout"><aside class="v2-brief-aside"><span class="eyebrow">ONE BRIEF. A CLEAR START.</span><p>Share the property, intended use and scope you have in mind. We’ll review your brief and discuss the requirements for a coordinated rehab project.</p><div class="v2-brief-expect"><span>WHAT HAPPENS NEXT</span><ol><li>We review your project brief.</li><li>We discuss the property and intended scope.</li><li>We identify what is needed for a site review.</li></ol></div><a href="tel:+12563931280" class="v2-contact-call">PREFER TO CALL?<strong>256-393-1280</strong></a><figure><img src="/assets/duplex-editorial.webp" width="1440" height="960" alt="Architectural concept of a renovated duplex with two separate front entries" /></figure></aside>
<div class="v2-brief-card"><form id="project-inquiry" novalidate>
<fieldset><legend><span>01</span> THE PROPERTY</legend><p>Choose the closest fit.</p><div class="v2-property-choices">{['Full-home rehab','Duplex / fourplex rehab','Commercial property rehab','Multiple properties','Kitchen / bathroom','Decks / exterior'].map((v,i)=><label><input type="radio" name="projectType" value={v} required /><span><small>0{i+1}</small>{v}</span></label>)}</div>
<div class="v2-fields"><label class="v2-field full">PROPERTY LOCATION <input name="city" placeholder="City or town in North Alabama" autocomplete="address-level2" maxlength="120" required /></label></div>
<div class="v2-goal"><span>YOUR GOAL <small>Optional</small></span><div>{['Rental / long-term hold','Rehab for resale','Business occupancy','Personal residence'].map(v=><label><input type="radio" name="goal" value={v} /><span>{v}</span></label>)}</div></div></fieldset>
<fieldset><legend><span>02</span> THE PLAN</legend><div class="v2-fields"><label class="v2-field">PROJECT BUDGET <select name="budget"><option value="">Select / optional</option>{['Under $50,000','$50,000–$100,000','$100,000–$250,000','$250,000–$500,000','$500,000–$1 million','$1 million+','Help me define the scope'].map(v=><option value={v}>{v}</option>)}</select></label><label class="v2-field">STARTING TIMELINE <select name="timeline"><option value="">Select / optional</option>{['As soon as practical','Within 3 months','3–6 months','6+ months','Exploring an acquisition'].map(v=><option value={v}>{v}</option>)}</select></label><label class="v2-field full">PROPERTY CONDITION & INTENDED SCOPE <textarea name="details" required maxlength="4500" placeholder="Describe the current condition, intended use and work you have in mind. For multiple properties, include the property types and approximate number of units." rows="5"></textarea></label></div></fieldset>
<fieldset><legend><span>03</span> YOUR DETAILS</legend><div class="v2-fields"><label class="v2-field full">YOUR NAME <input name="name" autocomplete="name" maxlength="120" required /></label><label class="v2-field full">COMPANY / OWNERSHIP ENTITY <small>Optional</small><input name="company" autocomplete="organization" maxlength="120" /></label><label class="v2-field">EMAIL <input type="email" name="email" autocomplete="email" inputmode="email" maxlength="254" /></label><label class="v2-field">PHONE <input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="40" /></label></div><p class="v2-field-help">Provide an email address or phone number so we can respond.</p></fieldset>
<label class="v2-consent"><input type="checkbox" name="consent" required /><span>I agree to be contacted about this project. <a href="/privacy/">Privacy notice</a>.</span></label>
<div class="honeypot" aria-hidden="true"><label>Leave this blank<input name="website" tabindex="-1" autocomplete="off" /></label></div>
<p class="v2-form-error" data-form-error role="alert" hidden></p><button class="v2-button v2-submit" type="submit" data-form-submit>SEND YOUR PROJECT BRIEF <span><Icon /></span></button><p class="v2-form-fine">Your brief starts a project review. It does not confirm a price, appointment or construction agreement.</p>
<noscript><p>Please enable JavaScript or call <a href="tel:+12563931280">256-393-1280</a> to share your project.</p></noscript>
</form><div class="v2-success" data-form-success hidden role="status" tabindex="-1"><span class="eyebrow">PROJECT BRIEF / RECEIVED</span><h2>PROJECT BRIEF<br /><span>RECEIVED.</span></h2><p>Your brief has been saved to Apex’s project inbox. We’ll use the contact details you provided to discuss the next step.</p><p data-reference class="v2-reference"></p><a href="/client-experience/" class="v2-text-link">THE CLIENT EXPERIENCE <Icon /></a></div></div></section>
<script>import '../scripts/inquiry';</script>
</SiteLayout>
