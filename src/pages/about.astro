---
import ServicePage from "../components/ServicePage.astro";
const page = {
  "title": "About Apex | North Alabama Property Rehab",
  "description": "Apex coordinates full-property rehab and renovation for residential and commercial owners, investors and portfolio managers across North Alabama.",
  "kicker": "ABOUT APEX",
  "line1": "AMBITION.",
  "line2": "BUILT IN.",
  "intro": "Apex brings full-property rehab, project coordination and client visibility together. We work with owners and investors to define the transformation, organize the project team and keep a clear record of the work.",
  "photo": "/assets/deck-editorial.webp",
  "photoAlt": "Exterior renovation concept with timber decking, a pergola and updated windows",
  "items": [
    [
      "THE ENTIRE PROPERTY",
      "From structure and building systems to interiors and exteriors, the scope considers the property as a whole."
    ],
    [
      "OWNERS, INVESTORS & PORTFOLIOS",
      "Full homes, duplexes, fourplexes and commercial buildings, with the intended use guiding the project."
    ],
    [
      "A COORDINATED PROJECT TEAM",
      "The appropriate building professionals and qualified trades brought together around the agreed scope and responsibilities."
    ],
    [
      "VISIBILITY BUILT IN",
      "A private client portal for recorded scope, task progress, photographs, payment records and project documents."
    ],
    [
      "NORTH ALABAMA",
      "Serving property owners and investors across North Alabama, including those managing their properties from a distance."
    ],
    [
      "FROM SCOPE TO HANDOVER",
      "A defined process through project review, coordinated work, required inspection steps and an organized closeout."
    ]
  ]
};
---
<ServicePage {...page} />
