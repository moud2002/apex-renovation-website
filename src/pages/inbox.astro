---
import Icon from '../components/Icon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Private Website Inbox" description="Private inquiry management for Apex Property Renovation." privatePage>
  <section class="inbox-shell"><div class="wrap">
    <span class="eyebrow">Apex / Private website inbox</span><h1 style="font-size:var(--text-2xl);margin-top:var(--space-5)">New possibilities start here.</h1><p style="margin-top:var(--space-5)">This is the separate website inquiry inbox, not the client portal.</p>
    <form class="inbox-login" data-inbox-login><label>Username<input name="username" autocomplete="username" required /></label><label>Password<input type="password" name="password" autocomplete="current-password" required /></label><button type="submit" class="button button-dark">Sign in <span aria-hidden="true"><Icon name="arrow-up-right" /></span></button></form>
    <a class="text-link" href="/settings/">Return to passcode</a>
    <p data-inbox-error class="form-error" role="alert" hidden></p>
    <div data-inbox-workspace hidden><div class="inbox-counts" data-inbox-counts></div><div class="inbox-toolbar"><label for="inbox-filter">Show</label><select id="inbox-filter" data-inbox-filter><option value="all">All inquiries</option><option value="new">New</option><option value="contacted">Contacted</option><option value="closed">Closed</option></select><button type="button" class="button button-outline button-small" data-inbox-refresh>Refresh <Icon name="rotate-right" /></button><button type="button" class="button button-outline button-small" data-inbox-logout>Sign out</button></div><div data-inbox-list></div><p class="muted">No email or SMS notifications are connected. Check this inbox for new inquiries. Sessions are kept in memory and end when you reload or close the page.</p></div>
  </div></section><script>import '../scripts/inbox';</script>
</SiteLayout>
