---
import {BUILDING_TYPES,FINISHES} from '../lib/property-building';
import '../styles/property-lab.css';
import {INTERIOR_FINISHES,finishSwatch} from '../lib/interior-finishes';
---
<section class="property-lab model-study" data-model-study data-lab-view="split" aria-label="Linked property design studio">
 <header class="lab-heading"><div><span class="eyebrow">APEX / PROPERTY STUDIO</span><h3>One plan. Every perspective.</h3><p>Explore the building, select a room, consider the finish.</p></div><span class="lab-concept-label">ILLUSTRATIVE CONCEPT</span></header>
 <div class="lab-toolbar"><div class="lab-types" role="group" aria-label="Building type">{BUILDING_TYPES.map((b,i)=><button disabled type="button" data-lab-building={b.id} aria-pressed={i===0}>{b.name}</button>)}</div><label>Floor<select data-lab-floor aria-label="Select floor" disabled><option value="0">Ground floor</option></select></label></div>
 <div class="lab-options"><div class="lab-finishes" role="group" aria-label="Exterior finish">{Object.entries(FINISHES).map(([id,f],i)=><button disabled type="button" data-lab-finish={id} aria-pressed={i===0}><span style={`background:${f.wall};border-bottom-color:${f.roof}`} aria-hidden="true"/>{f.name}</button>)}</div><div class="lab-view-switch" role="group" aria-label="Studio view"><button type="button" data-lab-layout="split" aria-pressed="true">Split view</button><button type="button" data-lab-layout="3d" aria-pressed="false">3D</button><button type="button" data-lab-layout="2d" aria-pressed="false">2D plan</button></div></div>
 <div class="lab-interior"><label>Explore finishes<select data-lab-interior aria-label="Interior finish">{Object.entries(INTERIOR_FINISHES).map(([id,finish])=><option value={id}>{finish.name}</option>)}</select></label><span class="lab-interior-swatch" data-lab-interior-swatch set:html={finishSwatch('warm-oak','studio-swatch')}/><p data-lab-interior-note aria-live="polite">{INTERIOR_FINISHES['warm-oak'].note}</p><span class="lab-interior-help">Open cutaway to see the interior.</span></div>
 <div class="lab-workspace"><section class="lab-model-panel" aria-label="3D building"><div class="lab-panel-title"><span>01 / BUILDING</span><button type="button" data-lab-cut disabled aria-pressed="false">Open cutaway</button></div><div class="model-stage" data-model-canvas><p class="model-loading" data-model-loading>Loading architectural study</p></div><div class="lab-cameras" role="group" aria-label="Camera view">{['perspective','front','rear','left','right','aerial'].map((v,i)=><button type="button" disabled data-lab-camera={v} aria-pressed={i===0}>{v==='perspective'?'Reset':v}</button>)}<button type="button" disabled data-lab-rotate="-1" aria-label="Rotate building left">↶</button><button type="button" disabled data-lab-rotate="1" aria-label="Rotate building right">↷</button><button type="button" disabled data-lab-tilt="1" aria-label="Raise camera for a higher view">Higher</button><button type="button" disabled data-lab-tilt="-1" aria-label="Lower camera for a lower view">Lower</button></div></section><section class="lab-plan-panel" aria-label="Linked 2D plan"><div class="lab-panel-title"><span>02 / SAME FLOOR PLAN</span><span data-lab-plan-floor>Ground floor</span></div><div class="lab-plan" data-lab-plan></div><div class="lab-plan-zoom" role="group" aria-label="Plan zoom"><button type="button" data-lab-plan-fit>Fit</button><button type="button" data-lab-plan-zoom="-1" aria-label="Zoom out linked plan">−</button><span data-lab-plan-scale>100%</span><button type="button" data-lab-plan-zoom="1" aria-label="Zoom in linked plan">+</button></div><p class="lab-plan-help">Select a room to highlight it in both views.</p></section></div>
 <div class="lab-room-strip" data-lab-rooms role="group" aria-label="Select a room"></div>
 <footer class="lab-details"><div><span class="eyebrow">SELECTED SPACE</span><h4 data-lab-room-name>Living & dining</h4><p><strong data-lab-room-area></strong> <span data-lab-room-size></span></p></div><div><span class="eyebrow">EXTERIOR PALETTE</span><h4 data-lab-finish-name>Modern white</h4><p data-lab-finish-note>White walls · black roof · dark doors and frames</p></div><a class="lab-inquiry" href="/start-your-project/">Discuss a rehab <span aria-hidden="true">↗</span></a></footer>
 <p class="lab-disclosure" data-model-caption aria-live="polite">Synthetic dimensions in feet. Concepts for discussion; site measurements, circulation and compliance require project-specific review.</p>
</section>
<script>import '../scripts/property-model';</script>
