---
import Icon from './Icon.astro';
const { title = 'Your property has a next chapter.', text = 'Let’s find out what it could be. Tell us what you have in mind, and we’ll start with a conversation.', label = 'Start your project' } = Astro.props;
---
<section class="closing-cta">
  <div class="closing-text wrap" data-reveal><span class="eyebrow">Built around what comes next</span><h2>{title}</h2><p>{text}</p><a href="/start-your-project/" class="button button-gold">{label}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
  <div class="closing-line" aria-hidden="true"></div>
  <img class="closing-mark" src="/assets/apex-mark-gold-light.png" alt="" width="600" height="600" loading="lazy" />
</section>
