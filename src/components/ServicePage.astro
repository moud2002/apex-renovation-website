---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import CTA from './CTA.astro';
import ModelStudy from './ModelStudy.astro';
const {title,description,kicker,line1,line2,intro,items,photo,photoAlt,real=false,model=false,projectType=''}=Astro.props;
---
<SiteLayout title={title} description={description} dark>
<section class="v2-page-hero wrap"><span class="eyebrow">{kicker} / NORTH ALABAMA</span><h1>{line1}<br /><span>{line2}</span></h1><div class="v2-page-summary"><p>{intro}</p><a href={projectType ? `/start-your-project/?type=${encodeURIComponent(projectType)}` : "/start-your-project/"} class="v2-button">BUILD YOUR PROJECT <span><Icon /></span></a></div></section>
{photo&&<figure class="v2-wide-photo wrap"><img src={photo} alt={photoAlt} width="1448" height="1086" fetchpriority="high" />{real&&<figcaption>COMPLETED PROJECT / ORIGINAL PHOTOGRAPH</figcaption>}</figure>}
{model&&<section class="wrap v2-page-model"><ModelStudy /></section>}
<section class="v2-section wrap"><div class="v2-section-head"><div><span class="eyebrow">THE PROJECT / DEFINED</span><h2>EVERY PART.<br /><span class="v2-muted">ONE CLEAR PLAN.</span></h2></div><p>Each property is different. Your scope, selections and project agreement define the work.</p></div><div class="v2-scope-grid">{items.map(([h,p],i)=><article><span>0{i+1}</span><h3>{h}</h3><p>{p}</p></article>)}</div></section>
<slot />
<section class="wrap apex-service-portal"><span class="eyebrow">YOUR SCOPE. YOUR PROGRESS. YOUR PROJECT RECORD.</span><a class="v2-text-link" href="/client-experience/">EXPLORE THE CLIENT EXPERIENCE <Icon /></a></section>
<CTA />
</SiteLayout>
