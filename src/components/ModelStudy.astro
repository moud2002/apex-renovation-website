---
import PlanStudy from './PlanStudy.astro';
import PropertyConcept from './PropertyConcept.astro';
const {compact=false}=Astro.props;
---
<div class:list={['property-design-lab',compact&&'design-compact']}>
 <PlanStudy />
 <details class="design-3d" open><summary><span>EXPLORE THE LINKED PROPERTY STUDIO</span><span>Home · Multifamily · Office / retail ↗</span></summary><p class="design-3d-note">The home uses the sample plan above. Every building below has its own linked 2D and 3D geometry.</p><PropertyConcept compact={compact}/></details>
</div>
