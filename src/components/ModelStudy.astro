---
import PlanStudy from './PlanStudy.astro';
import PropertyConcept from './PropertyConcept.astro';
const {compact=false}=Astro.props;
---
<div class:list={['property-design-lab',compact&&'design-compact']}>
 <PlanStudy />
 <details class="design-3d"><summary><span>EXPLORE 3D PROPERTY CONCEPTS</span><span>Home · Duplex · Fourplex ↗</span></summary><p class="design-3d-note">Separate illustrative building studies. Rotate the model, explore its structure, or view its layout.</p><PropertyConcept compact={compact}/></details>
</div>
