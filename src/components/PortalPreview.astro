---
const { id = 'client-workspace' } = Astro.props;
const panels = [
  { key: 'scope', label: 'Scope', number: '01', title: 'THE AGREED WORK. ON RECORD.', description: 'Review the scope and selections recorded for your property, with a clear distinction between included and deferred work.', rows: [['Scope of work', 'Included items and work status'], ['Selections', 'Recorded materials and finish decisions'], ['Deferred items', 'Work identified outside the current scope']] },
  { key: 'progress', label: 'Work plan', number: '02', title: 'SEE THE SEQUENCE.', description: 'Follow the work plan by phase. Progress reflects tasks marked complete by the project team, with the schedule alongside it.', rows: [['Project phases', 'A structured view of the work'], ['Task progress', 'Completed and remaining checklist items'], ['Schedule', 'Planned tasks and recorded crew bookings']] },
  { key: 'updates', label: 'Updates', number: '03', title: 'THE WORK, DOCUMENTED.', description: 'Dated photographs and project updates give context to the work, whether you are nearby or managing the property from a distance.', rows: [['Photo journal', 'Project photographs uploaded by the team'], ['Dated updates', 'A record of the work as it develops'], ['Project history', 'Updates kept with the property']] },
  { key: 'financials', label: 'Payment records', number: '04', title: 'KEEP THE FIGURES IN VIEW.', description: 'Review the recorded contract amount, draw schedule and payment history in the same workspace as the work.', rows: [['Contract amount', 'The value recorded for your project'], ['Draw schedule', 'Scheduled, invoiced and paid statuses'], ['Payment history', 'A record of payments entered by the team']] },
  { key: 'documents', label: 'Documents', number: '05', title: 'ONE PLACE FOR THE RECORD.', description: 'Access uploaded contracts, invoices and project reference files, with a downloadable snapshot of your project record.', rows: [['Project files', 'Uploaded contracts, invoices and references'], ['Protected access', 'Documents associated with your project'], ['Project record', 'A downloadable snapshot of recorded information']] },
];
---
<div class="apex-workspace" data-client-workspace>
  <div class="apex-workspace-bar"><span class="apex-workspace-brand">APEX<span>CLIENT PORTAL</span></span><span class="apex-workspace-label">PORTAL WALKTHROUGH</span></div>
  <div class="apex-workspace-tabs" role="tablist" aria-label="Explore client portal features">
    {panels.map((panel, index) => <button type="button" role="tab" id={`${id}-tab-${panel.key}`} aria-controls={`${id}-panel-${panel.key}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{panel.label}</button>)}
  </div>
  {panels.map((panel, index) => <div class="apex-workspace-panel" role="tabpanel" id={`${id}-panel-${panel.key}`} aria-labelledby={`${id}-tab-${panel.key}`} tabindex="0" hidden={index !== 0}>
    <div class="apex-workspace-panel-copy"><span class="eyebrow">{panel.number} / YOUR PROJECT WORKSPACE</span><h3>{panel.title}</h3><p>{panel.description}</p></div>
    <dl class="apex-workspace-records">{panel.rows.map(([label, detail]) => <div><dt>{label}</dt><dd>{detail}</dd></div>)}</dl>
  </div>)}
  <p class="apex-workspace-note">Explore the features above. Client workspaces show the information recorded for each project.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-client-workspace]').forEach(workspace => {
    const tabs = Array.from(workspace.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(workspace.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const activate = (selected: HTMLButtonElement, focus = false) => {
      tabs.forEach(tab => { const active = tab === selected; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
      panels.forEach(panel => { panel.hidden = panel.id !== selected.getAttribute('aria-controls'); });
      if (focus) selected.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', event => {
        let target: number;
        if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') target = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        else return;
        event.preventDefault(); activate(tabs[target], true);
      });
    });
    workspace.dataset.enhanced = 'true';
  });
</script>
<noscript><style>.apex-workspace-tabs{display:none}.apex-workspace-panel[hidden]{display:grid}</style></noscript>
